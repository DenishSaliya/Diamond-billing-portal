
{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "hosting": {
    "site": "om-maruti-diamond",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/customers",
        "destination": "/customers.html"
      },
      {
        "source": "/customers/**",
        "destination": "/customer.html"
      },
      {
        "source": "/sales/new",
        "destination": "/new-sale.html"
      },
      {
        "source": "/sales/new/**",
        "destination": "/new-sale.html"
      },
      {
        "source": "/sales",
        "destination": "/sales.html"
      },
      {
        "source": "/sales/**",
        "destination": "/sale.html"
      },
      {
        "source": "/invoices/**",
        "destination": "/invoice.html"
      },
      {
        "source": "/suppliers",
        "destination": "/suppliers.html"
      },
      {
        "source": "/suppliers/**",
        "destination": "/supplier.html"
      },
      {
        "source": "/purchases/new",
        "destination": "/new-purchase.html"
      },
      {
        "source": "/purchases",
        "destination": "/purchases.html"
      },
      {
        "source": "/purchases/**",
        "destination": "/purchase.html"
      },
      {
        "source": "/purchase-invoices/**",
        "destination": "/purchase-invoice.html"
      },
      {
        "source": "/profile",
        "destination": "/profile.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}